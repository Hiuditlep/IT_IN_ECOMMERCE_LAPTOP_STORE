# Sao chép file này thành backend/.env.local rồi điền giá trị thật.
# KHÔNG commit file .env.local lên git.

# Chuỗi kết nối PostgreSQL trên Neon
# (Neon Console → project → nút Connect → Connection string)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Cổng chạy backend (mặc định 5000)
PORT=5000
